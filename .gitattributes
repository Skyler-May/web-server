# Java / Maven 后端换行符规范
#
# 统一 LF 入库，避免 Windows 与 Linux/macOS 之间反复产生「只差换行符」的假 diff。
# .bat 脚本必须保留 CRLF，否则 cmd.exe 解析可能出错（尤其含 goto/label 的脚本）。

* text=auto eol=lf

# ---------------------------------------------------------------------------
# 源码与配置：文本 LF
# ---------------------------------------------------------------------------
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# ---------------------------------------------------------------------------
# Windows 脚本：必须 CRLF
# ---------------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ---------------------------------------------------------------------------
# Unix 脚本：必须 LF（否则 shebang 失效）
# ---------------------------------------------------------------------------
*.sh text eol=lf
gradlew text eol=lf

# ---------------------------------------------------------------------------
# 二进制
# ---------------------------------------------------------------------------
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.p12 binary
*.jks binary
*.keystore binary

# ---------------------------------------------------------------------------
# 构建产物与 IDE
# ---------------------------------------------------------------------------
target/** -text -diff linguist-vendored
*.class -text -diff
*.iml -text -diff linguist-generated
.idea/** -text -diff linguist-vendored
